# Copy to .env (or set in the build environment, e.g. Render). Read at BUILD time by Vite.

# Overpass interpreter URL(s) overriding the public servers. Several URLs separated by commas
# are tried in order. The server must allow CORS (Access-Control-Allow-Origin).
# OVERPASS_URL=https://overpass.example.org/api/interpreter

# 'dev' to send edits to the OSM dev API (master.apis.dev.openstreetmap.org)
# VITE_OSM_ENV=dev

# --- Cloudflare Worker (runtime, NOT build time) ---
# Pl@ntNet API key: put it in .dev.vars for `npm run dev` (file ignored by git),
# and as an encrypted secret of the Worker for production:
#   npx wrangler secret put PLANTNET_API_KEY
# PLANTNET_API_KEY=xxxxxxxx
