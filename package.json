{
  "name": "osmtree",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "dev:client": "vite",
    "dev:worker": "mkdir -p dist && wrangler dev --ip 127.0.0.1 --port 8788",
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:worker\"",
    "typecheck": "tsc -b && tsc -p worker/tsconfig.json",
    "build": "npm run typecheck && vite build",
    "preview": "npm run build && wrangler dev --ip 127.0.0.1",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "maplibre-gl": "^6.19.0",
    "osm-auth": "^4.0.0",
    "osm-request": "^2.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261121.1",
    "@eslint/js": "^10.0.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "wrangler": "^4.166.0"
  }
}
